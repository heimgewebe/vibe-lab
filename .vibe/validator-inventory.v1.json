        "validate-result-assessment-readiness",
        "validate-dependency-risk-caveat-scope-tests",
        "validate-dependency-risk-caveat-scope",
        "validate-pr-scope-tests",
        "validate-pr-scope",
        "agent-check-tests",
        "validate-promotion-readiness",
