{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heimgewebe/vibe-lab/schemas/active-experiments.v1.schema.json",
  "title": "Vibe-Lab Active Experiments v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "max_active",
    "experiments"
  ],
  "properties": {
    "schema_version": {
      "const": "active-experiments.v1"
    },
    "max_active": {
      "type": "integer",
      "const": 5
    },
    "experiments": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiment_id",
          "path",
          "state",
          "consumer",
          "decision_target",
          "primary_metric",
          "review_at",
          "expires_at",
          "source_ref"
        ],
        "properties": {
          "experiment_id": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^experiments/[^/]+$"
          },
          "state": {
            "enum": [
              "designed",
              "testing",
              "pilot"
            ]
          },
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "decision_target": {
            "type": "string",
            "minLength": 10
          },
          "primary_metric": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "review_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
