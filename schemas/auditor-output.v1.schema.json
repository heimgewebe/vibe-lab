{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heimgewebe/vibe-lab/schemas/auditor-output.v1.schema.json",
  "title": "Auditor Output (v1)",
  "description": "Schema für artifacts/<run-id>/auditor-output.yml. Maschinell autoritative Claim-Prüfung. Form wird hier validiert; semantische Konsistenz (Severity-Precedence, PASS-Konsistenz) prüft validate_run_bundle.py zusätzlich.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "contract", "run_id", "auditor", "overall_verdict", "claims"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contract": {
      "type": "string",
      "const": "auditor_output"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "pr_ref": {
      "type": "string",
      "minLength": 1
    },
    "auditor": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "executor": { "type": "string" },
            "date": { "type": "string" }
          }
        }
      ]
    },
    "auditor_date": {
      "type": "string"
    },
    "overall_verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "CLAIM_NOT_PROVEN",
        "CONTRADICTION",
        "MISSING_EVIDENCE",
        "OUT_OF_SCOPE",
        "NOT_REPRODUCIBLE"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "out_of_scope_claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "contradictions": {
      "type": "array"
    },
    "missing_evidence": {
      "type": "array"
    },
    "required_next_proof": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "text", "type", "verdict"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Claim-Typ. Empfohlene Werte: file_changed, command_succeeded, validator_succeeded, generated_artifact_updated, scope_adhered_to, agent_usage."
        },
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "CLAIM_NOT_PROVEN",
            "CONTRADICTION",
            "MISSING_EVIDENCE",
            "OUT_OF_SCOPE",
            "NOT_REPRODUCIBLE"
          ]
        },
        "evidence": {
          "type": "array"
        },
        "missing_evidence": {
          "type": "array"
        },
        "notes": { "type": "string" }
      }
    }
  }
}
