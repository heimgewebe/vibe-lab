{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heimgewebe/vibe-lab/schemas/effect-evaluation.observations.v2.schema.json",
  "title": "Vibe-Lab Effect Evaluation Observations v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "registration_sha256",
    "metric",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "effect-evaluation.observations.v2"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9][a-z0-9-]*$"
    },
    "registration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metric": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "condition",
          "value",
          "effort_seconds",
          "scoring_blinded",
          "comparison_key",
          "evidence_ref",
          "evidence_sha256",
          "decision_maker_ref",
          "observer_ref",
          "independent",
          "captured_at"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._:-]+$"
          },
          "condition": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "value": {
            "type": "number"
          },
          "effort_seconds": {
            "type": "number",
            "minimum": 0
          },
          "scoring_blinded": {
            "type": "boolean"
          },
          "comparison_key": {
            "type": "string",
            "minLength": 3
          },
          "pair_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "pattern": "^(receipt|github|vibe-lab|artifact|chronik):[^\\s]+$"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decision_maker_ref": {
            "type": "string",
            "pattern": "^(receipt|github|vibe-lab|artifact|chronik):[^\\s]+$"
          },
          "observer_ref": {
            "type": "string",
            "pattern": "^(receipt|github|vibe-lab|artifact|chronik):[^\\s]+$"
          },
          "independent": {
            "type": "boolean"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "score_components": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          }
        }
      }
    }
  }
}
