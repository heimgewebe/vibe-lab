{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heimgewebe/vibe-lab/schemas/experiment.registration.v2.schema.json",
  "title": "Vibe-Lab Prospective Experiment Registration v2",
  "$comment": "triggered_by: Bureau task OPERATOR-ECOSYSTEM-REDUNDANCY-V1-T005; new-registration semantics are activated fail-closed by validate_experiment_registration.py without rewriting historical registrations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "consumer",
    "decision_target",
    "intervention",
    "control_condition",
    "treatment_condition",
    "measurement",
    "comparison",
    "evidence_sources",
    "review_at",
    "expires_at",
    "closure",
    "boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "experiment.registration.v2"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9][a-z0-9-]*$"
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organ",
        "use"
      ],
      "properties": {
        "organ": {
          "type": "string",
          "minLength": 1
        },
        "use": {
          "type": "string",
          "minLength": 10
        },
        "relationship": {
          "const": "external"
        },
        "commitment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence_ref",
            "confirmed_at",
            "valid_until"
          ],
          "properties": {
            "status": {
              "const": "confirmed"
            },
            "evidence_ref": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$"
            },
            "confirmed_at": {
              "type": "string",
              "format": "date-time"
            },
            "valid_until": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "decision_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "owner"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 10
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$"
        }
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "control_condition": {
      "$ref": "#/$defs/condition"
    },
    "treatment_condition": {
      "$ref": "#/$defs/condition"
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_metric",
        "direction",
        "unit",
        "minimum_material_effect",
        "cost_metric",
        "method",
        "success",
        "falsification"
      ],
      "properties": {
        "primary_metric": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ]
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.%/-]*$"
        },
        "minimum_material_effect": {
          "type": "number",
          "minimum": 0
        },
        "method": {
          "type": "string",
          "minLength": 10
        },
        "success": {
          "type": "string",
          "minLength": 5
        },
        "falsification": {
          "type": "string",
          "minLength": 5
        },
        "outcome_criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "success_threshold",
            "harm_or_falsification_threshold"
          ],
          "properties": {
            "success_threshold": {
              "type": "number"
            },
            "harm_or_falsification_threshold": {
              "type": "number"
            }
          }
        },
        "scorecard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "components"
          ],
          "properties": {
            "schema_version": {
              "const": "additive-binary-scorecard.v1"
            },
            "components": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "weight",
                  "criterion"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "criterion": {
                    "type": "string",
                    "minLength": 10
                  },
                  "fatal_when_zero": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "cost_metric": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "unit",
            "method"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            "unit": {
              "const": "seconds"
            },
            "method": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "unit",
        "minimum_control",
        "minimum_treatment",
        "comparability_constraints",
        "confounders"
      ],
      "properties": {
        "mode": {
          "enum": [
            "paired",
            "unpaired"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 3
        },
        "minimum_control": {
          "type": "integer",
          "minimum": 3
        },
        "minimum_treatment": {
          "type": "integer",
          "minimum": 3
        },
        "comparability_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "confounders": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "evidence_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "independent_observation_required"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "independent_observation_required": {
          "const": true
        }
      }
    },
    "review_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_outcomes",
        "archive_path"
      ],
      "properties": {
        "allowed_outcomes": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "promote",
              "pilot",
              "defer",
              "reject",
              "archive"
            ]
          },
          "maxItems": 5,
          "allOf": [
            {
              "contains": {
                "const": "promote"
              }
            },
            {
              "contains": {
                "const": "pilot"
              }
            },
            {
              "contains": {
                "const": "defer"
              }
            },
            {
              "contains": {
                "const": "reject"
              }
            },
            {
              "contains": {
                "const": "archive"
              }
            }
          ]
        },
        "archive_path": {
          "type": "string",
          "pattern": "^experiments/_archive/[^/]+$"
        },
        "outcome_by_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "success",
            "harm_or_falsification",
            "inconclusive",
            "expired"
          ],
          "properties": {
            "success": {
              "enum": [
                "promote",
                "pilot"
              ]
            },
            "harm_or_falsification": {
              "enum": [
                "reject",
                "archive"
              ]
            },
            "inconclusive": {
              "enum": [
                "pilot",
                "defer",
                "archive"
              ]
            },
            "expired": {
              "const": "archive"
            }
          }
        }
      }
    },
    "surface_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durable_additions",
        "durable_offsets",
        "reviewed_exception"
      ],
      "properties": {
        "durable_additions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^add:[^\\s]+$"
          }
        },
        "durable_offsets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(remove|replace|retire):[^\\s]+$"
          }
        },
        "reviewed_exception": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/reviewedSurfaceException"
            }
          ]
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_only",
        "no_auto_policy",
        "no_auto_routing",
        "no_queue_authority",
        "no_runtime_authority"
      ],
      "properties": {
        "experiment_only": {
          "const": true
        },
        "no_auto_policy": {
          "const": true
        },
        "no_auto_routing": {
          "const": true
        },
        "no_queue_authority": {
          "const": true
        },
        "no_runtime_authority": {
          "const": true
        },
        "no_merge_authority": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "reviewedSurfaceException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_by",
        "review_ref",
        "reviewed_at",
        "rationale"
      ],
      "properties": {
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "review_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
