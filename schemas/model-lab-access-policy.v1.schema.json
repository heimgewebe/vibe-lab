{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heimgewebe/vibe-lab/schemas/model-lab-access-policy.v1.schema.json",
  "title": "Model-Lab Run-004 Access Policy v1",
  "description": "Closed Run-004 access-policy contract binding the sandbox launcher, workspace-isolation plan, Bubblewrap/libseccomp backend, stdin prompt delivery, and per-slot mount sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "contract_version",
    "policy_id",
    "synthetic_fixture",
    "triggered_by",
    "series_id",
    "design_id",
    "challenge_version",
    "runtime_root",
    "launcher_ref",
    "launcher_sha256",
    "isolation_plan_ref",
    "isolation_plan_sha256",
    "backend",
    "sandbox_environment",
    "allowed_command_roots",
    "required_read_only_roots",
    "optional_read_only_roots",
    "arms"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "artifact_type": {"type": "string", "const": "model_lab_access_policy"},
    "contract_version": {"type": "string", "const": "run-004-access-policy.v1"},
    "policy_id": {"$ref": "#/$defs/token"},
    "synthetic_fixture": {"type": "boolean"},
    "triggered_by": {"$ref": "#/$defs/nonBlank"},
    "series_id": {"type": "string", "const": "2026-05-31_model-lab-replication-series"},
    "design_id": {"type": "string", "const": "run-004-condition-contrast"},
    "challenge_version": {"type": "string", "const": "rest-api-v1"},
    "runtime_root": {"$ref": "#/$defs/absolutePath"},
    "launcher_ref": {"$ref": "#/$defs/repoPath"},
    "launcher_sha256": {"$ref": "#/$defs/sha256"},
    "isolation_plan_ref": {"$ref": "#/$defs/repoPath"},
    "isolation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "executable",
        "minimum_version",
        "seccomp_library",
        "host_filesystem_base_mounted",
        "namespace_mode",
        "share_net_required_due_to_netlink_route",
        "network_enforcement",
        "denied_syscall_errno",
        "denied_syscalls",
        "drop_capabilities",
        "clear_environment",
        "new_session",
        "die_with_parent",
        "close_fds",
        "argv_only",
        "shell_eval_forbidden",
        "bind_implementation",
        "prompt_delivery",
        "unset_pwd",
        "pwd_removed_by_argv_wrapper",
        "environment_wrapper",
        "tty"
      ],
      "properties": {
        "id": {"type": "string", "const": "bubblewrap-libseccomp-fd-stdin-v1"},
        "executable": {"type": "string", "const": "/usr/bin/bwrap"},
        "minimum_version": {"type": "string", "const": "0.6.1"},
        "seccomp_library": {"type": "string", "const": "libseccomp.so.2"},
        "host_filesystem_base_mounted": {"type": "boolean", "const": false},
        "namespace_mode": {"type": "string", "const": "unshare-all-share-net-seccomp-network-deny"},
        "share_net_required_due_to_netlink_route": {"type": "boolean", "const": true},
        "network_enforcement": {"type": "string", "const": "libseccomp-errno-eperm"},
        "denied_syscall_errno": {"type": "string", "const": "EPERM"},
        "denied_syscalls": {
          "type": "array",
          "prefixItems": [
            {"const": "socket"},
            {"const": "socketpair"},
            {"const": "connect"},
            {"const": "bind"},
            {"const": "listen"},
            {"const": "accept"},
            {"const": "accept4"},
            {"const": "sendto"},
            {"const": "sendmsg"},
            {"const": "sendmmsg"},
            {"const": "recvfrom"},
            {"const": "recvmsg"},
            {"const": "recvmmsg"},
            {"const": "shutdown"},
            {"const": "getsockname"},
            {"const": "getpeername"},
            {"const": "setsockopt"},
            {"const": "getsockopt"},
            {"const": "io_uring_setup"},
            {"const": "io_uring_enter"},
            {"const": "io_uring_register"},
            {"const": "mount"},
            {"const": "umount2"},
            {"const": "open_tree"},
            {"const": "move_mount"},
            {"const": "fsopen"},
            {"const": "fsconfig"},
            {"const": "fsmount"},
            {"const": "fspick"},
            {"const": "mount_setattr"},
            {"const": "pivot_root"},
            {"const": "chroot"},
            {"const": "setns"},
            {"const": "unshare"},
            {"const": "ptrace"},
            {"const": "bpf"},
            {"const": "perf_event_open"},
            {"const": "keyctl"},
            {"const": "add_key"},
            {"const": "request_key"},
            {"const": "open_by_handle_at"},
            {"const": "name_to_handle_at"}
          ],
          "minItems": 42,
          "maxItems": 42,
          "items": false
        },
        "drop_capabilities": {"type": "boolean", "const": true},
        "clear_environment": {"type": "boolean", "const": true},
        "new_session": {"type": "boolean", "const": true},
        "die_with_parent": {"type": "boolean", "const": true},
        "close_fds": {"type": "boolean", "const": true},
        "argv_only": {"type": "boolean", "const": true},
        "shell_eval_forbidden": {"type": "boolean", "const": true},
        "bind_implementation": {"type": "string", "const": "directory-fd-no-symlink-components"},
        "prompt_delivery": {"type": "string", "const": "stdin-only"},
        "unset_pwd": {"type": "boolean", "const": true},
        "pwd_removed_by_argv_wrapper": {"type": "boolean", "const": true},
        "environment_wrapper": {
          "type": "array",
          "prefixItems": [{"const": "/usr/bin/env"}, {"const": "-u"}, {"const": "PWD"}, {"const": "--"}],
          "minItems": 4,
          "maxItems": 4,
          "items": false
        },
        "tty": {"type": "boolean", "const": false}
      }
    },
    "sandbox_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HOME", "LANG", "LC_ALL", "PATH", "TMPDIR", "XDG_CACHE_HOME"],
      "properties": {
        "HOME": {"type": "string", "const": "/workspace"},
        "LANG": {"type": "string", "const": "C.UTF-8"},
        "LC_ALL": {"type": "string", "const": "C.UTF-8"},
        "PATH": {"type": "string", "const": "/usr/bin:/bin"},
        "TMPDIR": {"type": "string", "const": "/tmp"},
        "XDG_CACHE_HOME": {"type": "string", "const": "/cache"}
      }
    },
    "allowed_command_roots": {
      "type": "array",
      "prefixItems": [{"const": "/usr/bin"}, {"const": "/bin"}],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "required_read_only_roots": {
      "type": "array",
      "prefixItems": [{"const": "/usr"}],
      "minItems": 1,
      "maxItems": 1,
      "items": false
    },
    "optional_read_only_roots": {
      "type": "array",
      "prefixItems": [{"const": "/lib"}, {"const": "/lib64"}, {"const": "/etc/ld.so.cache"}],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "treatment"],
      "properties": {
        "control": {"$ref": "#/$defs/arm"},
        "treatment": {"$ref": "#/$defs/arm"}
      }
    }
  },
  "$defs": {
    "token": {"type": "string", "minLength": 1, "pattern": "^(?!.*\\s).+$"},
    "nonBlank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\u0000-\\u001F\\u007F\\uD800-\\uDFFF])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "absolutePath": {"type": "string", "minLength": 2, "pattern": "^/[^\\0]+$"},
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "workspace_source",
        "temp_source",
        "cache_source",
        "delivery_source",
        "payload_sha256",
        "workspace_target",
        "temp_target",
        "cache_target"
      ],
      "properties": {
        "slot_id": {"$ref": "#/$defs/token"},
        "workspace_source": {"$ref": "#/$defs/absolutePath"},
        "temp_source": {"$ref": "#/$defs/absolutePath"},
        "cache_source": {"$ref": "#/$defs/absolutePath"},
        "delivery_source": {"$ref": "#/$defs/absolutePath"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "workspace_target": {"type": "string", "const": "/workspace"},
        "temp_target": {"type": "string", "const": "/tmp"},
        "cache_target": {"type": "string", "const": "/cache"}
      }
    }
  }
}
