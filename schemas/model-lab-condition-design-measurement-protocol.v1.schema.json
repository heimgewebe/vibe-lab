{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heimgewebe/vibe-lab/schemas/model-lab-condition-design-measurement-protocol.v1.schema.json",
  "title": "Model-Lab Condition Design — Measurement Protocol v1",
  "description": "Closed contract for the shared measurement protocol. additionalProperties:false forbids observed_values and any unknown result field; metrics declare units/formulas only, no values. Ratio metrics require a range; the validator enforces 0..1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "design_id", "series_id", "challenge_version",
    "applies_equally_to_both_arms", "post_hoc_metric_selection_forbidden",
    "does_not_record_values", "treatment_only_scoring_forbidden",
    "primary_metrics", "secondary_metrics", "aborted_arm_rule", "missing_value_rule", "scope_drift_rule"
  ],
  "properties": {
    "artifact_type": {"type": "string", "const": "model_lab_condition_design_measurement_protocol"},
    "design_id": {"$ref": "#/$defs/token"},
    "series_id": {"$ref": "#/$defs/token"},
    "challenge_version": {"$ref": "#/$defs/token"},
    "applies_equally_to_both_arms": {"type": "boolean", "const": true},
    "post_hoc_metric_selection_forbidden": {"type": "boolean", "const": true},
    "does_not_record_values": {"type": "boolean", "const": true},
    "treatment_only_scoring_forbidden": {"type": "boolean", "const": true},
    "primary_metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "secondary_metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "aborted_arm_rule": {"$ref": "#/$defs/nonBlank"},
    "missing_value_rule": {"$ref": "#/$defs/nonBlank"},
    "scope_drift_rule": {"$ref": "#/$defs/nonBlank"}
  },
  "$defs": {
    "token": {"type": "string", "minLength": 1, "pattern": "^(?!.*\\s).+$"},
    "nonBlank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit", "formula"],
      "properties": {
        "id": {"$ref": "#/$defs/token"},
        "unit": {"type": "string", "enum": ["ratio", "boolean", "seconds", "count", "categorical"]},
        "formula": {"$ref": "#/$defs/nonBlank"},
        "range": {
          "type": "object", "additionalProperties": false, "required": ["minimum", "maximum"],
          "properties": {"minimum": {"type": "number"}, "maximum": {"type": "number"}}
        },
        "timer_start": {"$ref": "#/$defs/token"},
        "timer_end": {"$ref": "#/$defs/token"},
        "value_if_aborted_before_pass": {"$ref": "#/$defs/token"}
      },
      "allOf": [
        {
          "if": {"properties": {"unit": {"const": "ratio"}}, "required": ["unit"]},
          "then": {"required": ["range"]}
        }
      ]
    }
  }
}
