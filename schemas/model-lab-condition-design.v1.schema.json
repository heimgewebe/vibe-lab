{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heimgewebe/vibe-lab/schemas/model-lab-condition-design.v1.schema.json",
  "title": "Model-Lab Condition Design v1",
  "description": "Machine-readable, frozen-before-execution condition design for a future Model-Lab Run-004. v1 models exactly one honest state: a frozen paired design (design_status=frozen, condition_semantics_status=frozen, execution_binding_status=pending) that selects a single ASSIGNED workflow-instruction axis (workflow_protocol, semantics=assigned_instruction_requirement) and two future arms (control=direct_implementation, treatment=spec_first) for the open weak_condition_contrast blocker. It freezes condition semantics, input fragments, gate preconditions (via a frozen precondition snapshot, not live state), equality requirements, measurement definitions, and the future binding obligations; it does NOT bind concrete runtime values, execute a run, allow a result assessment, make the series comparison-ready, or resolve weak_condition_contrast. Fixed v1 values are pinned as const so they cannot drift. Genuinely cross-artifact semantics (snapshot identity and gate-requirement subset, design self-identity, bundle boundary, child-artifact identity/semantics, acyclic SHA-256 freeze without commit self-reference, recursive execution-artifact prohibition, safe paths, mandatory non-claims) live in scripts/docmeta/validate_model_lab_condition_design.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "triggered_by",
    "design_id",
    "design_status",
    "design_artifact_path",
    "series_id",
    "challenge_version",
    "challenge",
    "target_blocker",
    "target_blocker_status_after_design",
    "precondition_snapshot_ref",
    "primary_intervention_axis",
    "arms",
    "condition_input_assembly",
    "condition_input_claim",
    "condition_compliance_requirements",
    "artifact_surfaces",
    "process_artifacts_scored_as_outcome",
    "prompt_scope",
    "controlled_dimensions",
    "confounder_controls",
    "human_intervention",
    "verification_surface",
    "executable_harness_instance",
    "measurement_surface",
    "execution_readiness_requirements",
    "materiality_rationale",
    "condition_semantics_status",
    "design_constraints_frozen",
    "execution_binding_status",
    "runtime_values_bound",
    "run_004_execution_allowed",
    "result_assessment_allowed_after_design",
    "comparison_ready_after_design",
    "summary",
    "source_evidence",
    "freeze",
    "decision",
    "does_not_establish"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },
    "artifact_type": { "type": "string", "const": "model_lab_condition_design" },
    "triggered_by": { "$ref": "#/$defs/nonBlankString" },
    "design_id": { "$ref": "#/$defs/nonBlankToken" },
    "design_status": { "type": "string", "const": "frozen" },
    "design_artifact_path": { "$ref": "#/$defs/repoRelativePath" },
    "series_id": { "$ref": "#/$defs/nonBlankToken" },
    "challenge_version": { "$ref": "#/$defs/nonBlankToken" },
    "challenge": { "$ref": "#/$defs/challenge" },
    "target_blocker": { "type": "string", "const": "weak_condition_contrast" },
    "target_blocker_status_after_design": { "type": "string", "const": "open" },
    "precondition_snapshot_ref": { "$ref": "#/$defs/repoRelativePath" },
    "primary_intervention_axis": { "$ref": "#/$defs/primaryInterventionAxis" },
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/arm" }
    },
    "condition_input_assembly": { "$ref": "#/$defs/conditionInputAssembly" },
    "condition_input_claim": {
      "type": "string",
      "const": "same_benchmark_and_shared_context_differ_only_in_workflow_overlay",
      "$comment": "Pins the honest claim: NOT 'identical full input', but identical benchmark + shared context differing only in the assigned workflow overlay."
    },
    "condition_compliance_requirements": { "$ref": "#/$defs/conditionComplianceRequirements" },
    "artifact_surfaces": { "$ref": "#/$defs/artifactSurfaces" },
    "process_artifacts_scored_as_outcome": { "type": "boolean", "const": false },
    "prompt_scope": { "$ref": "#/$defs/promptScope" },
    "controlled_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/controlledDimension" }
    },
    "confounder_controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/confounderControl" }
    },
    "human_intervention": { "$ref": "#/$defs/humanIntervention" },
    "verification_surface": { "$ref": "#/$defs/verificationSurface" },
    "executable_harness_instance": { "$ref": "#/$defs/executableHarnessInstance" },
    "measurement_surface": { "$ref": "#/$defs/measurementSurface" },
    "execution_readiness_requirements": { "$ref": "#/$defs/executionReadinessRequirements" },
    "materiality_rationale": { "$ref": "#/$defs/nonBlankString" },
    "condition_semantics_status": { "type": "string", "const": "frozen" },
    "design_constraints_frozen": { "type": "boolean", "const": true },
    "execution_binding_status": { "type": "string", "const": "pending" },
    "runtime_values_bound": { "type": "boolean", "const": false },
    "run_004_execution_allowed": { "type": "boolean", "const": false },
    "result_assessment_allowed_after_design": { "type": "boolean", "const": false },
    "comparison_ready_after_design": { "type": "boolean", "const": false },
    "summary": { "$ref": "#/$defs/nonBlankString" },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceEvidence" },
      "$comment": "Context-only provenance (assessment_context / method_context). The authoritative gate/readiness preconditions live in the frozen precondition snapshot, not here."
    },
    "freeze": { "$ref": "#/$defs/freeze" },
    "decision": { "$ref": "#/$defs/decision" },
    "does_not_establish": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonBlankToken" }
    }
  },
  "$defs": {
    "nonBlankString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "nonBlankToken": { "type": "string", "minLength": 1, "pattern": "^(?!.*\\s).+$" },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F\\uD800-\\uDFFF])(?!\\s)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?:.*\\S)?$",
      "$comment": "Repo-relative POSIX path. Form errors rejected here; parent-escape, symlink-out-of-repo, existence, and bundle membership are resolver/semantic concerns."
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "source_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankToken" },
        "version": { "$ref": "#/$defs/nonBlankToken" },
        "path": { "$ref": "#/$defs/repoRelativePath" },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "primaryInterventionAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semantics", "selection_status", "required_axis_count"],
      "properties": {
        "id": { "type": "string", "const": "workflow_protocol" },
        "semantics": {
          "type": "string",
          "const": "assigned_instruction_requirement",
          "$comment": "The axis is an assigned instruction requirement (Spec-First present vs absent), not an enforced internal thought process."
        },
        "selection_status": { "type": "string", "const": "selected" },
        "required_axis_count": { "type": "integer", "const": 1 }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "workflow_protocol", "overlay_ref", "workflow_protocol_spec"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankToken" },
        "role": { "type": "string", "enum": ["control", "treatment"] },
        "workflow_protocol": { "$ref": "#/$defs/nonBlankToken" },
        "overlay_ref": { "$ref": "#/$defs/repoRelativePath" },
        "workflow_protocol_spec": { "$ref": "#/$defs/workflowProtocolSpec" },
        "derived_from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "source_sha256"],
          "properties": {
            "path": { "$ref": "#/$defs/repoRelativePath" },
            "source_sha256": { "$ref": "#/$defs/sha256" }
          },
          "$comment": "Provenance of an overlay derived from a canonical instruction block. Form + hash only; not re-checked against live files by the permanent validator."
        }
      }
    },
    "workflowProtocolSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_implementation_specification_required",
        "implementation_may_begin_immediately",
        "specification_completeness_checked_before_implementation",
        "required_specification_sections"
      ],
      "properties": {
        "pre_implementation_specification_required": { "type": "boolean" },
        "implementation_may_begin_immediately": { "type": "boolean" },
        "specification_completeness_checked_before_implementation": { "type": "boolean" },
        "required_specification_sections": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankToken" }
        }
      }
    },
    "conditionInputAssembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalization", "shared_input_ref", "arms"],
      "properties": {
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "line_endings", "final_newline"],
          "properties": {
            "encoding": { "type": "string", "const": "utf-8" },
            "line_endings": { "type": "string", "const": "lf" },
            "final_newline": { "type": "string", "const": "required" }
          }
        },
        "shared_input_ref": { "$ref": "#/$defs/repoRelativePath" },
        "arms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["control", "treatment"],
          "properties": {
            "control": { "$ref": "#/$defs/assemblyArm" },
            "treatment": { "$ref": "#/$defs/assemblyArm" }
          }
        }
      }
    },
    "assemblyArm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay_ref", "composition_order"],
      "properties": {
        "overlay_ref": { "$ref": "#/$defs/repoRelativePath" },
        "composition_order": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["shared_input", "arm_overlay"] }
        }
      }
    },
    "conditionComplianceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "treatment", "required_future_evidence"],
      "properties": {
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["specification_requirement_present"],
          "properties": {
            "specification_requirement_present": { "type": "boolean", "const": false }
          }
        },
        "treatment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["specification_requirement_present", "specification_complete_before_first_implementation_mutation"],
          "properties": {
            "specification_requirement_present": { "type": "boolean", "const": true },
            "specification_complete_before_first_implementation_mutation": { "type": "boolean", "const": true }
          }
        },
        "required_future_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankToken" }
        }
      }
    },
    "artifactSurfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common_outcome_artifacts", "required_future_process_evidence", "arm_specific_process_artifacts"],
      "properties": {
        "common_outcome_artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonBlankToken" } },
        "required_future_process_evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonBlankToken" } },
        "arm_specific_process_artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["control", "treatment"],
          "properties": {
            "control": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonBlankToken" } },
            "treatment": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonBlankToken" } }
          }
        }
      }
    },
    "promptScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_axis_is_bundled_workflow_instruction_protocol", "difference_not_attributable_to_ordering_length_structure_alone", "held_constant_across_arms"],
      "properties": {
        "primary_axis_is_bundled_workflow_instruction_protocol": { "type": "boolean", "const": true },
        "difference_not_attributable_to_ordering_length_structure_alone": { "type": "boolean", "const": true },
        "held_constant_across_arms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonBlankToken" } }
      }
    },
    "controlledDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "control_method", "binding_status", "binding_source", "same_value_across_arms_required", "blocking_divergence"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankToken" },
        "control_method": { "$ref": "#/$defs/nonBlankString" },
        "binding_status": { "type": "string", "enum": ["bound_at_design", "deferred_to_execution_readiness"] },
        "binding_source": { "$ref": "#/$defs/nonBlankString" },
        "same_value_across_arms_required": { "type": "boolean", "const": true },
        "blocking_divergence": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "confounderControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "controlled_by", "effect_if_uncontrolled"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankToken" },
        "controlled_by": { "$ref": "#/$defs/nonBlankString" },
        "effect_if_uncontrolled": { "type": "string", "enum": ["blocks_design", "must_be_reported"] }
      }
    },
    "humanIntervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_across_arms_required", "binding_status", "asymmetric_intervention_forbidden"],
      "properties": {
        "same_across_arms_required": { "type": "boolean", "const": true },
        "binding_status": { "type": "string", "const": "deferred_to_execution_readiness" },
        "asymmetric_intervention_forbidden": { "type": "boolean", "const": true }
      }
    },
    "verificationSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_status", "protocol_ref"],
      "properties": {
        "binding_status": { "type": "string", "const": "bound_at_design" },
        "protocol_ref": { "$ref": "#/$defs/repoRelativePath" }
      }
    },
    "executableHarnessInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_status"],
      "properties": {
        "binding_status": { "type": "string", "const": "deferred_to_execution_readiness" }
      }
    },
    "measurementSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_status", "protocol_ref"],
      "properties": {
        "binding_status": { "type": "string", "const": "bound_at_design" },
        "protocol_ref": { "$ref": "#/$defs/repoRelativePath" }
      }
    },
    "executionReadinessRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_repository_commit_across_arms",
        "clean_start_state_required",
        "separate_worktree_per_arm",
        "fresh_session_per_arm",
        "shared_conversation_context_forbidden",
        "cross_arm_artifact_reuse_forbidden",
        "treatment_spec_reuse_by_control_forbidden",
        "execution_order_must_be_declared"
      ],
      "properties": {
        "same_repository_commit_across_arms": { "type": "boolean", "const": true },
        "clean_start_state_required": { "type": "boolean", "const": true },
        "separate_worktree_per_arm": { "type": "boolean", "const": true },
        "fresh_session_per_arm": { "type": "boolean", "const": true },
        "shared_conversation_context_forbidden": { "type": "boolean", "const": true },
        "cross_arm_artifact_reuse_forbidden": { "type": "boolean", "const": true },
        "treatment_spec_reuse_by_control_forbidden": { "type": "boolean", "const": true },
        "execution_order_must_be_declared": { "type": "boolean", "const": true }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "$ref": "#/$defs/repoRelativePath" },
        "kind": { "type": "string", "enum": ["assessment_context", "method_context"] }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_before_execution", "freeze_manifest_ref"],
      "properties": {
        "frozen_before_execution": { "type": "boolean", "const": true },
        "freeze_manifest_ref": { "$ref": "#/$defs/repoRelativePath" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "next_step", "reason"],
      "properties": {
        "status": { "type": "string", "const": "frozen" },
        "next_step": { "type": "string", "const": "run_004_execution_readiness_may_be_assessed" },
        "reason": { "$ref": "#/$defs/nonBlankString" }
      }
    }
  }
}
