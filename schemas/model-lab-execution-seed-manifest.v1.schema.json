{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heimgewebe/vibe-lab/schemas/model-lab-execution-seed-manifest.v1.schema.json",
  "title": "Model-Lab Execution Seed Manifest v1",
  "description": "Closed content manifest for the identical Run-004 execution seed used by both arms.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "seed_id",
    "synthetic_fixture",
    "root_ref",
    "content_hash_algorithm",
    "content_sha256",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "artifact_type": {
      "type": "string",
      "const": "model_lab_execution_seed_manifest"
    },
    "seed_id": {
      "$ref": "#/$defs/token"
    },
    "synthetic_fixture": {
      "type": "boolean"
    },
    "content_hash_algorithm": {
      "type": "string",
      "const": "sha256(sorted(repo_relative_path + NUL + file_sha256 + LF) over files)"
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "root_ref": {
      "$ref": "#/$defs/path"
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\s).+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F\\uD800-\\uDFFF])(?!\\s)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?:.*\\S)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
