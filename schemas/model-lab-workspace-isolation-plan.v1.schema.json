{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heimgewebe/vibe-lab/schemas/model-lab-workspace-isolation-plan.v1.schema.json",
  "title": "Model-Lab Run-004 Workspace Isolation Plan v1",
  "description": "Operator-side create-only plan for two opaque isolated Run-004 workspaces and assigned prompt packages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "plan_id",
    "series_id",
    "design_id",
    "challenge_version",
    "synthetic_fixture",
    "runtime_root",
    "create_only_if_absent",
    "seed_manifest_ref",
    "seed_manifest_sha256",
    "delivery",
    "slots"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "artifact_type": {
      "type": "string",
      "const": "model_lab_workspace_isolation_plan"
    },
    "plan_id": {
      "$ref": "#/$defs/token"
    },
    "series_id": {
      "type": "string",
      "const": "2026-05-31_model-lab-replication-series"
    },
    "design_id": {
      "type": "string",
      "const": "run-004-condition-contrast"
    },
    "challenge_version": {
      "type": "string",
      "const": "rest-api-v1"
    },
    "synthetic_fixture": {
      "type": "boolean"
    },
    "runtime_root": {
      "$ref": "#/$defs/absolutePath"
    },
    "create_only_if_absent": {
      "type": "boolean",
      "const": true
    },
    "seed_manifest_ref": {
      "$ref": "#/$defs/repoPath"
    },
    "seed_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "newline",
        "final_newline",
        "separator",
        "composition_order",
        "prompt_filename"
      ],
      "properties": {
        "encoding": {
          "type": "string",
          "const": "utf-8"
        },
        "newline": {
          "type": "string",
          "const": "lf"
        },
        "final_newline": {
          "type": "string",
          "const": "required"
        },
        "separator": {
          "type": "string",
          "const": "\\n\\n"
        },
        "composition_order": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "benchmark"
            },
            {
              "type": "string",
              "const": "shared_condition"
            },
            {
              "type": "string",
              "const": "assigned_overlay"
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "prompt_filename": {
          "type": "string",
          "const": "task.md"
        }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "treatment"
      ],
      "properties": {
        "control": {
          "$ref": "#/$defs/slot"
        },
        "treatment": {
          "$ref": "#/$defs/slot"
        }
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\s).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/[^\\0]+$"
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "slot_root",
        "workspace_path",
        "delivery_path",
        "session_id",
        "temp_dir",
        "cache_dir",
        "port_assignment",
        "allowed_paths",
        "forbidden_paths",
        "cleanup_rule",
        "benchmark_ref",
        "shared_condition_ref",
        "overlay_ref",
        "payload_sha256"
      ],
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/token"
        },
        "slot_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "workspace_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "delivery_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "session_id": {
          "$ref": "#/$defs/token"
        },
        "temp_dir": {
          "$ref": "#/$defs/absolutePath"
        },
        "cache_dir": {
          "$ref": "#/$defs/absolutePath"
        },
        "port_assignment": {
          "$ref": "#/$defs/token"
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/absolutePath"
          }
        },
        "forbidden_paths": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/absolutePath"
          }
        },
        "cleanup_rule": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "benchmark_ref": {
          "$ref": "#/$defs/repoPath"
        },
        "shared_condition_ref": {
          "$ref": "#/$defs/repoPath"
        },
        "overlay_ref": {
          "$ref": "#/$defs/repoPath"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
