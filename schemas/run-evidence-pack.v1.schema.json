{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heimgewebe/vibe-lab/schemas/run-evidence-pack.v1.schema.json",
  "title": "Run Evidence Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version (SemVer format: major.minor.patch)"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "type",
        "verdict",
        "evidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "type": "string",
          "$comment": "PR 4 validates verdict vocabulary only. Semantic claim/evidence compatibility is enforced later by the PR 5 validator.",
          "enum": [
            "PASS",
            "CLAIM_NOT_PROVEN",
            "NOT_REPRODUCIBLE",
            "MISSING_EVIDENCE",
            "OUT_OF_SCOPE",
            "CONTRADICTION"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "status": {
          "type": "string",
          "$comment": "PR 4 validates evidence status vocabulary only. PASS eligibility per status is intentionally out of scope.",
          "enum": [
            "repo_local",
            "external_verified",
            "external_unverified",
            "ci_artifact",
            "derived_from_auditor_output",
            "missing_evidence",
            "self_reported",
            "unknown"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object"
            }
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        }
      }
    }
  }
}
